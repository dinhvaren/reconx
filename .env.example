# Docker deployment configuration (copy to .env).
# The database identifiers below retain legacy names so an existing local
# volume can be reused without a migration.
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# Web exposure: loopback-only by default. Set 0.0.0.0 only behind an HTTPS reverse proxy.
RECONX_BIND=127.0.0.1
# Host port. Keep 8787 unless the host OS has reserved that port.
RECONX_PORT=8787

# First-run authentication. Leave both blank for a random token printed once in `docker compose logs reconx`.
# ARTEX_SETUP_TOKEN is never logged. ARTEX_ADMIN_PASSWORD initializes only an empty installation;
# remove the plaintext password after initialization or inject it with your deployment secret manager.
ARTEX_SETUP_TOKEN=
ARTEX_ADMIN_PASSWORD=

# Exact browser origins, comma-separated. Blank keeps the local development defaults.
# Wildcard origins are rejected.
ARTEX_CORS_ORIGINS=

# 9Router OpenAI-compatible gateway. Put the gateway key only in .env or a
# secret manager. The application appends /chat/completions to this base URL,
# so do not add that suffix here.
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=openai
ARTEX_LLM_MODEL=ocg/deepseek-v4.1-flash
ARTEX_LLM_BASE_URL=https://9router.dinhvaren.io.vn/v1
ARTEX_LLM_PROXY=

# Exact 9Router model IDs used by the existing profiles:
#   ocg/deepseek-v4.1-flash (default)
#   ocg/minimax-m3.1-flash
#   ocg/glm-5.3-flash
#   ocg/kimi-k3.1-pro
